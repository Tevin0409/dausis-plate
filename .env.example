# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth redirects and QR links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the order status page ("Call us")
NEXT_PUBLIC_RESTAURANT_PHONE=+2547XXXXXXXX

# Cloudflare R2 (R2 → Manage API tokens, Object Read & Write on one bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dausis-plate-photos
# Public URL of the bucket: its r2.dev URL or a custom domain, e.g. https://photos.dausisplate.co.ke
# Stored photo URLs are built from this, so set it before uploading real photos.
NEXT_PUBLIC_PHOTO_BASE_URL=

# M-Pesa Daraja (stubbed in this pass)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
